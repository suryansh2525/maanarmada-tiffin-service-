# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: for server-side admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# After you buy a domain, set this to the admin hostname only.
# Example: admin.yourkitchen.com
# Until then, leave it blank — admin stays at /admin on localhost
# and is not linked from the customer site.
ADMIN_HOST=
